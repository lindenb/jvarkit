Bootstrap: docker
From: ubuntu:24.04

%post
    apt-get -y update && apt-get -y install \
        git wget openjdk-17-jdk make
    git clone --recurse-submodules --recursive --branch v2026.04.30 https://github.com/lindenb/jvarkit.git
    cd jvarkit
    # Fix for special character on compilation (since commit #c8ccc25):
    export JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8"
    make
    cd ../
    mkdir -p /opt
    mv "/jvarkit" "/opt/"
    echo '#!/bin/bash' > /usr/local/bin/jvarkit 
    echo 'java -jar /opt/jvarkit/dist/jvarkit.jar "$@"' >> /usr/local/bin/jvarkit
    chmod +x /usr/local/bin/jvarkit

%environment
    export JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8"
    export PATH=/usr/local/bin:$PATH

%test
	echo "Version: $(jvarkit --version)"
	
%runscript
	jvarkit "$@"

%labels
	Author Pierre Lindenbaum
    Refactoring Charles VAN GOETHEM

%help
	This is a container for jvarkit.
	Create the image as : `apptainer build jvarkit_2026.04.30.sif jvarkit.def`
	Run as : `apptainer exec jvarkit`
