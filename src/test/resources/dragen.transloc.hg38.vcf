##fileformat=VCFv4.2
##FILTER=<ID=PASS,Description="All filters passed">
##ALT=<ID=DEL,Description="Deletion">
##ALT=<ID=DUP:TANDEM,Description="Tandem Duplication">
##ALT=<ID=INS,Description="Insertion">
##ALT=<ID=INV,Description="Inversion">
##DRAGENVersion=<ID=dragen,Version="SW: 4.6.2, HW: 07.031.849">
##FILTER=<ID=ColocationSum,Description="The sum of the square region in the colocation matrix centered on variant coordinates with width 200000 and normalized by the median diagonal count does not meet the threshold of 1">
##FILTER=<ID=Duplicate,Description="Variant is equivalent to other variants encoding the same haplotype but uses a different notation.">
##FILTER=<ID=FailedDepth,Description="SV depth is not following the expectation once compared to the flanking region. A deletion gets filtered, if the breakend depth is larger than 0.8x flanking depth. A duplication gets filtered, if the breakend depth is smaller than 1.2x flanking depth">
##FILTER=<ID=LargeContigFilter,Description="Assembled contig at SV locus does not successfully realign to the regions +- 200bp of both breakends with mapq >= 40 and identity >= 90%.">
##FILTER=<ID=LowSupport,Description="Either the number of unique paired reads supporting the SV is less than 3 or the number of PR reads is less than 1 or the number of SR read is less than 1">
##FILTER=<ID=LowVAF,Description="VAF is less than threshold(0.15). Filter applies only to IMPRECISE BND records.">
##FILTER=<ID=MLFail,Description="Prob(TP) < 0.167706 for deletions or Prob(TP) < 0.161275 for insertions.">
##FILTER=<ID=MaxDepth,Description="Depth is greater than 3x the median chromosome depth near one or both variant breakends">
##FILTER=<ID=MaxMQ0Frac,Description="For a small variant (<1000 bases), the fraction of reads in all samples with MAPQ0 around either breakend exceeds 0.4">
##FILTER=<ID=MinGQ,Description="GQ score is less than 5 (filter applied at sample level)">
##FILTER=<ID=MinQUAL,Description="QUAL score is less than 76">
##FILTER=<ID=Ploidy,Description="For DEL & DUP variants, the genotypes of overlapping variants (with similar size) are inconsistent with diploid expectation">
##FILTER=<ID=SampleFT,Description="No sample passes all the sample-level filters">
##FILTER=<ID=StrandBias,Description="For a small deletion (<1000 bases), more than a half of samples have strand bias">
##FORMAT=<ID=FS,Number=1,Type=Float,Description="Phred-scaled p-value using Fisher's exact test to detect strand bias">
##FORMAT=<ID=FT,Number=.,Type=String,Description="Genotype-level filter">
##FORMAT=<ID=GQ,Number=1,Type=Integer,Description="Genotype Quality">
##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">
##FORMAT=<ID=MLQS,Number=1,Type=Integer,Description="ML recalibrated QUAL for indels">
##FORMAT=<ID=PL,Number=G,Type=Integer,Description="Normalized, Phred-scaled likelihoods for genotypes as defined in the VCF specification">
##FORMAT=<ID=PR,Number=R,Type=Integer,Description="Spanning paired-read support for the ref and alt alleles in the order listed">
##FORMAT=<ID=SB,Number=4,Type=Integer,Description="Per-sample component statistics which comprise the Fisher's Exact Test to detect strand bias">
##FORMAT=<ID=SR,Number=R,Type=Integer,Description="Split reads for the ref and alt alleles in the order listed, for reads where P(allele|read)>0.999">
##FORMAT=<ID=VAF1,Number=A,Type=Float,Description="Variant allele fraction at the variant first breakend">
##FORMAT=<ID=VAF2,Number=A,Type=Float,Description="Variant allele fraction at the variant second breakend">
##FORMAT=<ID=VF,Number=R,Type=Integer,Description="Number of DNA fragments support of the breakend mates for the ref and alt alleles in the order listed">
##FORMAT=<ID=VF1,Number=R,Type=Integer,Description="Number of DNA fragments support of the first breakend for the ref and alt alleles in the order listed">
##FORMAT=<ID=VF2,Number=R,Type=Integer,Description="Number of DNA fragments support of the second breakend for the ref and alt alleles in the order listed">
##INFO=<ID=BND_DEPTH,Number=1,Type=Integer,Description="Read depth at local translocation breakend">
##INFO=<ID=CIEND,Number=2,Type=Integer,Description="Confidence interval around END">
##INFO=<ID=CIGAR,Number=A,Type=String,Description="CIGAR alignment for each alternate indel allele">
##INFO=<ID=CIPOS,Number=2,Type=Integer,Description="Confidence interval around POS">
##INFO=<ID=COLOCATION,Number=0,Type=Flag,Description="This record was generated by the colocation module">
##INFO=<ID=DUPLICATES,Number=.,Type=String,Description="The variant(s) that this record duplicates, either directly or as part of a transitive path through other variants.">
##INFO=<ID=END,Number=1,Type=Integer,Description="End position of the variant described in this record">
##INFO=<ID=EVENT,Number=1,Type=String,Description="ID of event associated to breakend">
##INFO=<ID=EVENTTYPE,Number=A,Type=String,Description="Type of associated event">
##INFO=<ID=HAPALIGNMENTSQ,Number=1,Type=Float,Description="Assembled haplotype alignment score">
##INFO=<ID=HAPDRAGENASSEMBLERNORMTSQ,Number=1,Type=Float,Description="DRAGEN assembler score of the assembled haplotype normalized by num nodes in the path">
##INFO=<ID=HAPDRAGENASSEMBLERTSQ,Number=1,Type=Float,Description="DRAGEN assembler score of the assembled haplotype">
##INFO=<ID=HAPREPEATTABOOLERTSQ,Number=1,Type=Float,Description="Repeattaboo assembler score of the assembled haplotype">
##INFO=<ID=HASGA,Number=1,Type=Integer,Description="Whether the SV is in a loci with GA pop-alts">
##INFO=<ID=HOMLEN,Number=.,Type=Integer,Description="Length of base pair identical homology at event breakpoints">
##INFO=<ID=HOMSEQ,Number=.,Type=String,Description="Sequence of base pair identical homology at event breakpoints">
##INFO=<ID=IMPRECISE,Number=0,Type=Flag,Description="Imprecise structural variation">
##INFO=<ID=INCOMPLETEINS,Number=0,Type=Flag,Description="Variant corresponds to an incompletely assembled insertion sequence">
##INFO=<ID=INTEGRATION_TYPE,Number=1,Type=String,Description="The type of the sequence the incomplete insertion matched to (e.g. VIRAL, MEI)">
##INFO=<ID=JUNCTION_QUAL,Number=1,Type=Integer,Description="If the SV junction is part of an EVENT (ie. a multi-adjacency variant), this field provides the QUAL value for the adjacency in question only">
##INFO=<ID=LCF,Number=1,Type=String,Description="Status for the large contig filter. Possible values: SUCCESS, NO_ALIGNMENTS, NO_VALID_BP1_ALN, NO_VALID_BP2_ALN, ORIENTATION_MISMATCH.">
##INFO=<ID=LEFT_SVINSSEQ,Number=.,Type=String,Description="Known left side of insertion for an insertion of unknown length">
##INFO=<ID=MATEID,Number=.,Type=String,Description="ID of mate breakend">
##INFO=<ID=MATE_BND_DEPTH,Number=1,Type=Integer,Description="Read depth at remote translocation mate breakend">
##INFO=<ID=ML_UPDATED,Number=0,Type=Flag,Description="The FILTER status has changed from PASS to non-PASS or non-PASS to PASS after QUAL being recalibrated by ML">
##INFO=<ID=NORMALIZED_COLOC_SUM,Number=1,Type=Float,Description="The sum of the square region in the colocation matrix centered on variant coordinates with width 200000 and normalized by the median diagonal count">
##INFO=<ID=PHASEDASM,Number=1,Type=String,Description="Haplotype of the reads used for the assembly yielding the SV">
##INFO=<ID=READLIKELIHOOD,Number=1,Type=Float,Description="Assembled haplotype read likelihood score">
##INFO=<ID=REFPOPALTID,Number=.,Type=String,Description="A list of ref pop-alts used to assemble this contig">
##INFO=<ID=RIGHT_SVINSSEQ,Number=.,Type=String,Description="Known right side of insertion for an insertion of unknown length">
##INFO=<ID=SVINSLEN,Number=.,Type=Integer,Description="Length of insertion">
##INFO=<ID=SVINSSEQ,Number=.,Type=String,Description="Sequence of insertion">
##INFO=<ID=SVLEN,Number=.,Type=Integer,Description="Difference in length between REF and ALT alleles">
##INFO=<ID=SVTYPE,Number=1,Type=String,Description="Type of structural variant">
